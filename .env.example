NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=service-role-placeholder-never-expose-to-browser
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
APP_URL=http://localhost:3000
# 32+ byte hex secret. Derives stable member QR payloads; changing it invalidates every derived pass QR.
PASS_QR_SECRET=replace-with-a-32-byte-hex-secret
# Local demo seed only. 12+ characters, unique, never commit the real value.
DEMO_SEED_PASSWORD=
# Set true only for local/demo deployments; never in production.
DEMO_MODE=false
