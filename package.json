{
  "name": "prism-pass",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:isolation": "vitest run tests/tenancy-isolation.test.ts",
    "audit:prod": "pnpm audit --prod",
    "security:secrets": "node scripts/security/scan-secrets.mjs",
    "security:secrets:all": "node scripts/security/scan-secrets.mjs --all",
    "brand:generate": "tsx scripts/brand/generate.ts",
    "brand:og": "tsx scripts/brand/render-og.tsx",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "seed:syntaxure": "tsx prisma/seed/syntaxure.ts",
    "seed:demo": "tsx prisma/seed/demo.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.0",
    "@prisma/client": "6.19.3",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^8.20.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.11",
    "framer-motion": "^11.15.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.469.0",
    "next": "15.5.29",
    "next-themes": "^0.4.4",
    "pg": "^8.23.1",
    "qrcode.react": "^4.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.6.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
